  "description": "AI Trading Petrunko — real-time crypto intelligence HUD (educational project)",
  "scripts": {
    "core": "node tools/build-core.mjs",
    "predev": "node tools/build-core.mjs",
    "dev": "concurrently -n srv,web -k \"npm:server\" \"npm:client\"",
    "preserver": "node tools/build-core.mjs",
