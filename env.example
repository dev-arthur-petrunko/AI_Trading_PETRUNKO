# AI engine — переменные окружения (задача 4)
#
# Скопируй этот файл в `.env.local` (Next.js читает его автоматически).
# `.gitignore` полностью исключает `.env*` — секреты НИКОГДА не попадут в git/GitHub.
#
# Сюда вписывай доступ к своей модели. Сам AI-код подключается в
# components/ai/engine.ts (функция runAI), контракт полей — docs/AI_DATA.md.

# URL твоей AI-модели / внутреннего сервиса
AI_API_URL=http://127.0.0.1:8000/v1/chat/completions

# Имя модели
AI_MODEL=gpt-4o-mini

# Ключ доступа (остаётся локально!)
AI_API_KEY=

# Таймаут запроса, мс
AI_TIMEOUT_MS=8000

# Часовой интервал накопления данных (мс); 3600000 = 1 час по ТЗ
AI_SNAPSHOT_INTERVAL_MS=3600000
